#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

pass() { echo "[PASS] $1"; }
warn() { echo "[WARN] $1"; }
fail() { echo "[FAIL] $1"; }

progress_label() {
  local label="$1"
  local max_len="${2:-18}"
  if (( ${#label} > max_len )); then
    printf '%s...' "${label:0:$((max_len - 3))}"
  else
    printf '%s' "$label"
  fi
}

render_progress_line() {
  local prefix="$1"
  local label="$2"
  label="$(progress_label "$label")"
  printf '\r\033[2K%s %s' "$prefix" "$label" >&2
}

finish_progress_line() {
  render_progress_line "$1" "$2"
  printf '\n' >&2
}

spinner_until_pattern_or_exit() {
  local pid="$1"
  local logfile="$2"
  local pattern="$3"
  local label="$4"
  local timeout_seconds="${5:-20}"
  local start_time
  start_time="$(date +%s)"
  local i=0
  local frames=('|' '/' '-' '\')
  local use_animated=0
  if [[ -t 1 ]]; then
    use_animated=1
  fi

  while kill -0 "$pid" 2>/dev/null; do
    if grep -q "$pattern" "$logfile" 2>/dev/null; then
      if [[ "$use_animated" -eq 1 ]]; then
        finish_progress_line "[PASS]" "$label"
      else
        printf "[PASS] %s\n" "$label"
      fi
      return 0
    fi
    local now
    now="$(date +%s)"
    if (( now - start_time >= timeout_seconds )); then
      if [[ "$use_animated" -eq 1 ]]; then
        finish_progress_line "[WARN]" "$label (timed out waiting for ready signal)"
      else
        printf "[WARN] %s\n" "$(progress_label "$label timed out")" >&2
      fi
      return 1
    fi
    if [[ "$use_animated" -eq 1 ]]; then
      local frame="${frames[$((i % ${#frames[@]}))]}"
      render_progress_line "[$frame]" "$label"
      i=$((i + 1))
    elif [[ "$i" -eq 0 ]]; then
      printf "[....] %s\n" "$(progress_label "$label")" >&2
      i=1
    fi
    sleep 0.08
  done

  if grep -q "$pattern" "$logfile" 2>/dev/null; then
    if [[ "$use_animated" -eq 1 ]]; then
      finish_progress_line "[PASS]" "$label"
    else
      printf "[PASS] %s\n" "$(progress_label "$label")" >&2
    fi
    return 0
  fi

  if [[ "$use_animated" -eq 1 ]]; then
    finish_progress_line "[WARN]" "$label (process exited before ready signal)"
  else
    printf "[WARN] %s\n" "$(progress_label "$label exited")" >&2
  fi
  return 1
}

check_cmd() {
  local cmd="$1"
  local label="$2"
  if command -v "$cmd" >/dev/null 2>&1; then
    pass "$label found ($(command -v "$cmd"))"
    return 0
  fi
  fail "$label missing ($cmd)"
  return 1
}

run_selfcheck() {
  local ok=0

  check_cmd git "Git" || ok=1
  check_cmd xcodebuild "Xcode build tools" || ok=1
  check_cmd xcrun "Xcode runtime tools" || ok=1
  check_cmd swift "Swift toolchain" || ok=1

  if xcodebuild -version >/dev/null 2>&1; then
    pass "xcodebuild responds"
  else
    fail "xcodebuild not ready (open Xcode once and accept prompts/license)"
    ok=1
  fi

  if xcrun --sdk macosx metal -v >/dev/null 2>&1; then
    pass "Metal toolchain available via xcrun"
  else
    fail "Metal toolchain missing (run ./run setup)"
    ok=1
  fi

  if [[ -f "/Applications/Xcode.app/Contents/Developer/usr/bin/xcodebuild" ]]; then
    local active_dev_dir
    active_dev_dir="$(xcode-select -p 2>/dev/null || true)"
    if [[ "$active_dev_dir" == "/Applications/Xcode.app/Contents/Developer" ]]; then
      pass "xcode-select points to full Xcode"
    else
      warn "xcode-select is '$active_dev_dir' (recommend: sudo xcode-select -s /Applications/Xcode.app/Contents/Developer)"
    fi
  fi

  if command -v brew >/dev/null 2>&1; then
    pass "Homebrew found"
  else
    warn "Homebrew not found (optional, but recommended for project tooling)"
  fi

  if [[ $ok -ne 0 ]]; then
    echo
    fail "Selfcheck failed. Resolve FAIL items and rerun ./run selfcheck"
    return 1
  fi

  echo
  pass "Selfcheck complete"
}

subcmd="${1:-help}"
shift || true

case "$subcmd" in
  particles)
    mode="${1:-ui}"
    if [[ "$mode" == "headless" ]]; then
      shift || true
      echo "[INFO] Headless mode: build-only smoke check (no GUI launch)."
      swift build "$@"
      pass "Headless smoke check complete"
      exit 0
    fi

    swift build "$@"
    tmp_log="$(mktemp)"
    app_pid=""
    cleanup_particles() {
      local sig="${1:-}"
      if [[ -n "${app_pid:-}" ]] && kill -0 "$app_pid" 2>/dev/null; then
        kill "$app_pid" 2>/dev/null || true
        wait "$app_pid" 2>/dev/null || true
      fi
      rm -f "$tmp_log"
      trap - INT TERM HUP EXIT
      if [[ -n "$sig" ]]; then
        case "$sig" in
          INT) exit 130 ;;
          TERM|HUP) exit 143 ;;
        esac
      fi
    }
    trap 'cleanup_particles INT' INT
    trap 'cleanup_particles TERM' TERM
    trap 'cleanup_particles HUP' HUP
    trap 'cleanup_particles' EXIT

    "$ROOT_DIR/.build/debug/Particularity" >"$tmp_log" 2>&1 &
    app_pid=$!
    if ! spinner_until_pattern_or_exit "$app_pid" "$tmp_log" "APP_READY" "Launching UI" 20; then
      if [[ -s "$tmp_log" ]]; then
        cat "$tmp_log" >&2
      fi
      cleanup_particles
      exit 1
    fi
    set +e
    wait "$app_pid"
    status=$?
    set -e
    if [[ $status -ne 0 && -s "$tmp_log" ]]; then
      cat "$tmp_log" >&2
    fi
    trap - INT TERM HUP EXIT
    rm -f "$tmp_log"
    exit "$status"
    ;;
  build)
    swift build "$@"
    ;;
  setup)
    echo "Running utility setup for machine provisioning..."
    echo "Downloading Metal toolchain component (run this on M1.2 setup as requested)."
    xcodebuild -downloadComponent MetalToolchain
    ;;
  selfcheck)
    run_selfcheck
    ;;
  help|-h|--help)
    cat <<'HELP'
Utility subgroup commands:
  ./run util particles
  ./run util particles headless
  ./run util build
  ./run util setup
  ./run util selfcheck
  ./run util help

Top-level aliases:
  ./run particles
  ./run build
  ./run setup
  ./run selfcheck
HELP
    ;;
  *)
    echo "Unknown util subcommand: $subcmd" >&2
    exit 1
    ;;
esac
