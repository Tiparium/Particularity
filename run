#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_RSC_DIR="$ROOT_DIR/.run_rsc"

print_help() {
  local groups=""
  if [[ -d "$RUN_RSC_DIR" ]]; then
    groups="$(find "$RUN_RSC_DIR" -maxdepth 1 -type f -name '*.run' -exec basename {} .run \; | sort)"
  fi
  cat <<'HELP'
Usage: ./run <group> <subcommand> [args]

Router:
  ./run maps groups to .run_rsc/<group>.run
  ./run particle    (alias for ./run util particles)
  ./run crouton     (alias for ./run core hello_world)
  ./run particles   (alias for ./run util particles)
  ./run build       (alias for ./run util build)
  ./run setup      (alias for ./run util setup)
  ./run selfcheck  (alias for ./run util selfcheck)
  ./run help
  ./run <group> help
HELP
  if [[ -n "$groups" ]]; then
    echo
    echo "Available groups:"
    while IFS= read -r group; do
      echo "  $group"
    done <<<"$groups"
  fi
}

group="${1:-help}"
shift || true

case "$group" in
  particle)
    exec "$RUN_RSC_DIR/util.run" particles "$@"
    ;;
  crouton)
    exec "$RUN_RSC_DIR/core.run" hello_world "$@"
    ;;
  particles)
    exec "$RUN_RSC_DIR/util.run" particles "$@"
    ;;
  build)
    exec "$RUN_RSC_DIR/util.run" build "$@"
    ;;
  setup)
    exec "$RUN_RSC_DIR/util.run" setup "$@"
    ;;
  selfcheck)
    exec "$RUN_RSC_DIR/util.run" selfcheck "$@"
    ;;
  help|-h|--help|"")
    print_help
    ;;
  *)
    if [[ -x "$RUN_RSC_DIR/${group}.run" ]]; then
      exec "$RUN_RSC_DIR/${group}.run" "$@"
    fi
    echo "Unknown run group: $group" >&2
    print_help >&2
    exit 1
    ;;
esac
